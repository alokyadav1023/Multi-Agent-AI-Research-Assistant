# ==========================================
# Multi-Agent AI Research Assistant Config
# ==========================================

# Default Provider: nvidia, google, openai, groq, anthropic, ollama, or mock
DEFAULT_PROVIDER=nvidia

# NVIDIA NIM API
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Other LLM Providers
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Search API Keys
TAVILY_API_KEY=your_tavily_api_key_here

# Research Engine Limits
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_TOTAL_SOURCES=15
MAX_SCRAPED_CHARS=4000
DEFAULT_MAX_ITERATIONS=2
